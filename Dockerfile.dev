# Development image with hot reload. NOT the production isolation model: the
# source tree is bind-mounted and workers run as the container's user. Use
# Dockerfile.prod for anything that faces other people.
FROM node:24-bookworm-slim AS dev
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
EXPOSE 5173 3000
CMD ["npm", "run", "dev:server"]
