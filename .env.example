# Copy to .env for local development. Everything is optional; defaults are
# shown. See README.md for what each setting does.

# Login password (12+ characters). Without it every protected route denies
# access, unless PI_GATEWAY_INSECURE_DEV=1 (local development only).
# GATEWAY_PASSWORD=
# PI_GATEWAY_INSECURE_DEV=1

# Exact browser origin(s), comma separated. Anything else is rejected.
# ALLOWED_ORIGINS=http://localhost:5173

# Set to 1 when served over HTTPS so the session cookie is Secure.
# COOKIE_SECURE=1

# PORT=3000
# HOST=127.0.0.1
# PI_DATA_DIR=./.pi-data
# PI_AGENT_HOME=./.pi-data/agent-home
